!/ncu-reports/MANIFEST.sha256
!/ncu-reports/REPORTS.json

# Keep original notes and the small legacy Git backup available after cloning.
# Other local artifacts and build products remain ignored.
/artifacts/*
!/artifacts/git/
!/artifacts/import-originals/
/dist/
